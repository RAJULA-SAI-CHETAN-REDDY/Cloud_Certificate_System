{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverAndCreatePool",
      "Effect": "Allow",
      "Action": ["cognito-idp:ListUserPools", "cognito-idp:CreateUserPool"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
    },
    {
      "Sid": "ManageDevelopmentPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool", "cognito-idp:UpdateUserPool",
        "cognito-idp:GetUserPoolMfaConfig", "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:ListTagsForResource", "cognito-idp:TagResource", "cognito-idp:UntagResource",
        "cognito-idp:CreateUserPoolClient", "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient", "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateGroup", "cognito-idp:GetGroup", "cognito-idp:UpdateGroup", "cognito-idp:DeleteGroup",
        "cognito-idp:CreateUserPoolDomain", "cognito-idp:UpdateUserPoolDomain", "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:AdminCreateUser", "cognito-idp:AdminGetUser", "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminListGroupsForUser"
      ],
      "Resource": "arn:aws:cognito-idp:ap-south-1:707256068320:userpool/*"
    },
    {
      "Sid": "ReadDomain",
      "Effect": "Allow",
      "Action": "cognito-idp:DescribeUserPoolDomain",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
    }
  ]
}
