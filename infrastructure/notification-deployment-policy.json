    },
    {
      "Effect": "Allow",
      "Action": ["sns:GetSubscriptionAttributes", "sns:SetSubscriptionAttributes", "sns:Unsubscribe"],
      "Resource": ["arn:aws:sns:ap-south-1:707256068320:ccd-certificate-events", "arn:aws:sns:ap-south-1:707256068320:ccd-certificate-events:*"]
    }
  ]
